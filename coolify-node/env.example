# =========================
# Coolify node
# =========================
# Prepares a server so the Coolify panel can manage it: creates an unprivileged user, authorizes the
# panel's public key and grants passwordless sudo. Run this on the server that will be managed, not
# on the panel.

# STEP 1. Create the key in the panel, not here:
#   Coolify -> Settings -> Keys & Tokens -> + Add -> name it -> Save.
# The panel generates the pair itself and shows only the public half (the private one stays inside
# Coolify and is never printed). Copy that line and paste it below.
#
# STEP 2. Fill COOLIFY_SSH_PUBLIC_KEY with the copied line, then run setup-coolify-node.sh.
COOLIFY_SSH_PUBLIC_KEY='ssh-ed25519 AAAA... panel'

# Linux user the panel logs in as. Must not be root.
COOLIFY_USER=coolify

# SSH port the panel should use. Leave empty to read the first Port directive from sshd.
COOLIFY_SSH_PORT=

# Coolify installs Docker and manages the proxy through sudo without a password. Turning this off
# leaves the server reachable by SSH but not deployable: the panel cannot install anything.
COOLIFY_ALLOW_SUDO_NOPASSWD=true
