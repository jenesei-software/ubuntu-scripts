# =========================
# Mailcow behind system Caddy
# =========================

# This is the mail server FQDN, not the mail domain itself.
MAILCOW_HOSTNAME=mail.example.com
# Comma-separated domains that will be hosted by Mailcow. The setup does not
# create them; check-setup.sh uses this list for DNS diagnostics.
MAILCOW_MAIL_DOMAINS=example.com

MAILCOW_INSTALL_DIR=/opt/mailcow-dockerized
MAILCOW_TIMEZONE=Etc/UTC

# Pinned official Mailcow release and its verified commit.
MAILCOW_VERSION=2026-07
MAILCOW_GIT_COMMIT=96a70652c320d1c76979610df13c71f363ecc2de
# Set true only after verified backups when intentionally moving to the pinned release above.
MAILCOW_UPGRADE_CONFIRMED=false
# Existing installations are refused by default. Set true for one reviewed run
# to adopt an official checkout, then immediately return it to false.
MAILCOW_ADOPT_EXISTING=false

# Mailcow's web server stays on loopback. Do not use 8081, 9081, 9082, or 65510.
MAILCOW_HTTP_BIND=127.0.0.1
MAILCOW_HTTP_PORT=8080
MAILCOW_HTTPS_BIND=127.0.0.1
MAILCOW_HTTPS_PORT=8443

# Additional names that Caddy should proxy to the Mailcow UI.
# Use comma-separated FQDNs without spaces. Leave empty when not needed.
MAILCOW_ADDITIONAL_SERVER_NAMES=autodiscover.example.com,autoconfig.example.com

# Disable only on deliberately reduced installations. The default Mailcow
# configuration requires at least 6 GiB RAM plus 1 GiB swap.
MAILCOW_SKIP_CLAMD=false
MAILCOW_SKIP_FTS=false
# The setup does not rewrite Docker's host-wide IPv6 configuration. Set true
# only after configuring and testing Docker IPv6 using Mailcow's official guide.
MAILCOW_ENABLE_IPV6=false
MAILCOW_ALLOW_LOW_RESOURCES=false

MAILCOW_CONFIGURE_CADDY=true
CADDYFILE=/etc/caddy/Caddyfile
MAILCOW_CADDY_OVERWRITE_DOMAIN=ask

# Caddy terminates web TLS. This copies the same certificate into Mailcow for
# SMTP/IMAP TLS and refreshes it with a systemd timer.
MAILCOW_SYNC_CADDY_CERT=true
MAILCOW_CADDY_CERT_STORAGE=/var/lib/caddy/.local/share/caddy/certificates
