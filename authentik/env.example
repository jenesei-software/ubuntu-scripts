# =========================
# Authentik behind Caddy
# =========================
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_INSTALL_DIR=/opt/authentik
AUTHENTIK_BIND_IP=127.0.0.1
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# Versioned official Compose release. Upgrade only after reading Authentik's notes.
AUTHENTIK_VERSION=2026.5.5
AUTHENTIK_RELEASE_CHANNEL=2026.5

# The setup renames Authentik's built-in akadmin account when this differs.
AUTHENTIK_ADMIN_USERNAME=akadmin
# Use at least 16 characters. Quote the value when it contains shell-special characters.
AUTHENTIK_ADMIN_PASSWORD=change_me_authentik_admin_password
# Keep false normally. Set true for one run to rotate an existing administrator password.
AUTHENTIK_ADMIN_PASSWORD_ROTATE=false
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_ERROR_REPORTING=false

# The official worker mounts Docker's root-equivalent socket for automatic outposts.
# Keep this false when Authentik is used only as an identity provider.
AUTHENTIK_ENABLE_DOCKER_SOCKET=false
AUTHENTIK_ALLOW_LOW_RESOURCES=false
# Set true only after creating and verifying database/configuration backups for an upgrade.
AUTHENTIK_UPGRADE_CONFIRMED=false

AUTHENTIK_CONFIGURE_CADDY=true
CADDYFILE=/etc/caddy/Caddyfile
AUTHENTIK_CADDY_OVERWRITE_DOMAIN=ask

# Optional YouTrack OIDC integration used by setup-youtrack-oidc.sh.
# With Caddy enabled, that script also installs a one-minute JWKS cache because
# YouTrack 2026.2 allows only 500 ms for the JWKS response.
YOUTRACK_URL=https://youtrack.example.com
AUTHENTIK_YOUTRACK_APP_NAME=YouTrack
AUTHENTIK_YOUTRACK_APP_SLUG=youtrack
AUTHENTIK_YOUTRACK_CLIENT_ID=youtrack
# Provisional value for the first setup-youtrack-oidc.sh run. YouTrack generates
# a per-module .../interactive/login/<uuid>/land URI. Copy that exact URI here
# and rerun the script before enabling OIDC login.
YOUTRACK_OIDC_REDIRECT_URI=https://youtrack.example.com/hub/api/rest/oauth2/auth
