# =========================
# Mistgate panel
# =========================
# One self-hosted Mistgate panel on a dedicated Ubuntu 24.04 server.
# The panel owns TCP 80/443 itself: do not install the Caddy module on this
# host unless MISTGATE_TLS_MODE=caddy. Never put a CDN or TLS-terminating proxy
# in front of the panel: node agents pin the panel's own CA on TCP 443.

# Public HTTPS address of the panel. Clients only see the decoy site here;
# subscriptions, user pages and the admin live under secret paths.
# The host must point directly at this server (A/AAAA, no proxy).
MISTGATE_PUBLIC_URL=https://panel.example.com

# How the admin is reached after `mistgate setup` stores it once:
#   path   - https://panel.example.com/<24 random characters>/   (default)
#   host   - https://<MISTGATE_ADMIN_HOST>/ (needs DNS and a certificate)
#   listen - http://localhost:<port>/ through an SSH tunnel (not public)
MISTGATE_ADMIN_MODE=path

# Only for MISTGATE_ADMIN_MODE=host. Keep it unguessable and do not publish it.
MISTGATE_ADMIN_HOST=

# Only for MISTGATE_ADMIN_MODE=listen. Bind to loopback only.
MISTGATE_ADMIN_LISTEN=127.0.0.1:8081

# Where the public TLS certificate comes from:
#   acme  - the panel requests and renews Let's Encrypt certificates itself
#   files - your own PEM certificate and key (for example a wildcard)
#   caddy - the system Caddy terminates TLS and proxies to the panel
MISTGATE_TLS_MODE=acme

# Let's Encrypt contact address. Optional but recommended.
MISTGATE_ACME_EMAIL=

# Extra Let's Encrypt names besides the public URL host. Comma-separated.
# MISTGATE_ADMIN_HOST is added automatically in acme mode.
MISTGATE_ACME_DOMAINS=

# Listener for the ACME HTTP-01 challenge and the HTTP->HTTPS redirect.
# Set it to an empty value to disable port 80 entirely.
MISTGATE_ACME_HTTP=:80

# Only for MISTGATE_TLS_MODE=files. Readable by the panel service (root).
# Certificates are re-read when the files change, without a restart.
MISTGATE_TLS_CERT=
MISTGATE_TLS_KEY=

# Only for MISTGATE_TLS_MODE=caddy. Caddy must already be installed by caddy/.
# The panel is proxied on 127.0.0.1:8080 and node agents keep their own TLS
# listener on MISTGATE_AGENT_PORT, which Caddy must not touch.
CADDYFILE=/etc/caddy/Caddyfile
MISTGATE_CADDY_OVERWRITE_DOMAIN=ask
MISTGATE_AGENT_PORT=8443
# host:port that lands in the node install command. Defaults to
# <public URL host>:<MISTGATE_AGENT_PORT>.
MISTGATE_AGENT_ADDR=

# Optional static decoy site. The directory is created and connected
# automatically; copy your own site over the starter files there.
# Empty value disables it and the panel serves its built-in page.
# Keep it under 2 MiB and 4096 files if nodes should be able to copy it.
MISTGATE_DECOY_DIR=/srv/mistgate-decoy

# Starter site copied into MISTGATE_DECOY_DIR when it is empty:
#   auto | rybalka | palatki | gazirovka | bakery | veloservice
# auto picks one from a hash of the panel hostname. These are starters, not
# production decoys: replace the files or edit the texts before sharing.
# An existing site in the directory is never overwritten.
MISTGATE_DECOY_SITE=auto

# Panel data: SQLite database, master.key, ACME state and the node package.
# Back up this directory; losing master.key means re-enrolling every node.
MISTGATE_DATA_DIR=/var/lib/mistgate
MISTGATE_BIN_DIR=/usr/local/bin

# Release to install. Empty means the newest stable release.
# Pin an exact tag such as v0.1.89 for a repeatable install.
MISTGATE_VERSION=
# stable, testing or dev. Also written to the root-owned update channel policy
# and used by the panel for its own update checks.
MISTGATE_CHANNEL=stable

# Official Mistgate release key. Leave empty to trust the built-in key.
# Set both halves only when you ship your own signed builds.
MISTGATE_RELEASE_PUBLIC_KEY_BASE64=
MISTGATE_RELEASE_PUBLIC_KEY_SSH_BASE64=
# Refuse to install if the signed manifest does not verify. Do not disable.
MISTGATE_ALLOW_UNSIGNED_RELEASE=false

# Add 80/443 (and the agent port in caddy mode) to UFW when it is active.
# This module never enables UFW and never touches other firewall rules.
MISTGATE_CONFIGURE_UFW=true

# Preflight minimums. 1 CPU / 512 MB is enough for the panel alone.
MISTGATE_MIN_FREE_GB=3
MISTGATE_ALLOW_LOW_RESOURCES=false

# Only update-mistgate.sh uses these.
# A version change needs an explicit yes after you have an off-host backup.
MISTGATE_UPGRADE_CONFIRMED=false
# Reinstall the same version (repair the binary, refresh the unit).
MISTGATE_FORCE_UPDATE=false
