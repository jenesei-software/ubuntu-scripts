# =========================
# YouTrack Server behind Caddy
# =========================
YOUTRACK_URL=https://youtrack.example.com
YOUTRACK_INSTALL_DIR=/opt/youtrack
YOUTRACK_BIND_IP=127.0.0.1
YOUTRACK_PORT=8080

# Pin upgrades deliberately. Back up YouTrack before changing this tag.
YOUTRACK_IMAGE=jetbrains/youtrack:2026.2.17765
YOUTRACK_CONTAINER_NAME=youtrack
YOUTRACK_TIMEZONE=UTC

# Minimum free space required on the filesystem containing YOUTRACK_INSTALL_DIR.
YOUTRACK_MIN_FREE_GB=20
# Use only for a disposable test server with less than 2 GB RAM or 2 CPUs.
YOUTRACK_ALLOW_LOW_RESOURCES=false
# Set true only after creating and verifying an off-host backup for an intentional image upgrade.
YOUTRACK_UPGRADE_CONFIRMED=false

# Optional server-to-server OIDC route. Set both values when the public identity
# provider hostname is proxied by a CDN but YouTrack should reach its origin directly.
YOUTRACK_OIDC_HOST=
YOUTRACK_OIDC_ORIGIN_IP=

# true: update /etc/caddy/Caddyfile with a managed reverse_proxy block.
# false: install YouTrack only and configure the reverse proxy yourself.
YOUTRACK_CONFIGURE_CADDY=true
CADDYFILE=/etc/caddy/Caddyfile

# What to do if the YouTrack hostname already exists in Caddyfile and points elsewhere:
# ask   - ask before replacing the existing Caddy block
# true  - replace it without asking
# false - stop with an error
YOUTRACK_CADDY_OVERWRITE_DOMAIN=ask
