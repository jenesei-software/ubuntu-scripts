# =========================
# Cloudflare-only HTTP/HTTPS
# =========================
# Restricts Docker-published HTTP/HTTPS ports to Cloudflare's network, so a CDN in front of the
# service cannot be bypassed by talking to the origin address directly.

# Interface that faces the internet. Leave empty to detect it from the default route.
WAN_INTERFACE=

# TCP ports published by Docker that should accept Cloudflare traffic only.
HTTP_PORTS=80,443

# Name of the iptables chain this module creates and owns.
CHAIN_NAME=CF_ONLY_HTTP

# Extra CIDRs allowed in addition to Cloudflare, comma separated. Opt-in and risky: every CIDR added
# here can reach the origin without the CDN, which defeats the point for a consent or geo decision.
ALLOW_EXTRA_CIDRS=

# systemd unit, helper script and systemd timer name.
SERVICE_NAME=cf-only-http

# Install a weekly timer that refreshes the Cloudflare IP list. The list is refreshed on every boot
# and on every setup run either way; the timer matters for hosts that stay up for months.
REFRESH_TIMER=true
