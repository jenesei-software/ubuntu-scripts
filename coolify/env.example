# =========================
# Coolify self-hosted setup
# =========================

# Empty installs or upgrades to the current stable version.
# Example pinned version: 4.1.2
COOLIFY_VERSION=

# Official installer options.
AUTOUPDATE=true
REGISTRY_URL=docker.io
DOCKER_ADDRESS_POOL_BASE=10.0.0.0/8
DOCKER_ADDRESS_POOL_SIZE=24
DOCKER_POOL_FORCE_OVERRIDE=false

# Optional first administrator. Either set all three values or leave all empty.
# Setting these avoids exposing an unclaimed registration page on port 8000.
ROOT_USERNAME=
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=

# true allows a new install even when ports 80 or 443 are already occupied.
# Use only with a deliberately configured custom proxy; Coolify's default proxy
# cannot bind to ports already used by Caddy, Nginx, Apache, or another service.
COOLIFY_ALLOW_PROXY_PORT_CONFLICTS=false

# true adds UFW allow rules for 80, 443, 8000, 6001, and 6002 without enabling UFW.
# Docker-published ports can bypass UFW, so enforce exposure in the provider
# firewall as described in wiki/coolify.md.
COOLIFY_CONFIGURE_UFW=true

# true bypasses the initial 2 CPU, 2 GB RAM, and disk-space requirements.
# Keep false outside disposable test servers.
COOLIFY_ALLOW_LOW_RESOURCES=false
