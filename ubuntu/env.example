# =========================
# Ubuntu base setup
# =========================
ROOT_PASSWORD=change_me_root_password
USER_NAME=deploy
USER_PASSWORD=change_me_user_password
PORT_SSH=10022
SSH_PUB="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... your@email"
SERVER_NAME=ubuntu-prod-01

# Ubuntu profile for Mistgate:
#   none  - plain hardened Ubuntu (default)
#   panel - open 80/tcp and 443/tcp for the Mistgate panel
#   node  - open 80/tcp and 443/tcp and optionally prepare SSH so the panel
#           can install the node agent automatically
# The role only tunes this base module. It does not install Mistgate.
MISTGATE_ROLE=none

# Only with MISTGATE_ROLE=node.
# Paste the panel public key from Nodes -> Add node -> "Ключ панели".
# It is added to USER_NAME's authorized_keys.
MISTGATE_PANEL_SSH_PUB=

# Only with MISTGATE_ROLE=node.
# true  - USER_NAME gets passwordless sudo (ALL); required for the panel's
#         automatic SSH install while root login stays disabled.
#         Requires MISTGATE_PANEL_SSH_PUB.
# false - no broad sudo; use the panel's manual one-time install command.
# This is a real privilege grant. Leave false unless you want auto-install.
MISTGATE_PANEL_SSH_NOPASSWD=false

# Leave empty to keep the current IPv6 state.
# true disables IPv6. false actively enables IPv6 and allows UFW to create IPv6 rules.
DISABLE_IPV6=

# Optional when DISABLE_IPV6=false. Leave empty to auto-detect, or set eth0/ens3/etc.
IPV6_INTERFACE=
